# ------------------------------------------------------------
# THE BOSS — safe defaults
# ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
APP_MODE=live
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_POLL_MS=10000
# Delay between paged eth_getLogs requests; helps provider free-tier limits.
RPC_LOG_PAGE_DELAY_MS=75

# Already deployed THE BOSS contracts (Robinhood Chain mainnet)
TREASURY_ADDRESS=0x56245Ea05CfDB874e7678C590118C193CAceE049
FEE_ROUTER_ADDRESS=0xC1A6cEb8Ab361E6BFd8B7A61d5536B86235C06F3
PROJECT_RECIPIENT=0x0b397c40ee2b4EF6b91aBF17f3C7DeFc6901D7c7
EXPECTED_PONS_DEPLOYER=0x8aFDeA6c03A0C92f8Ed5EcB2C995E39D38eA0e01
SECURITY_ADMIN=0xe41E8eF10BfeD94B299aED18c43e2Aaa540285B1
GUARDIAN=0xed0a8688DeeB6C975Ab6A5204f50075c5F380E19
REPORTER_A=0x4Dd63079b134C37e8e869b997432920c91bA4BcC
REPORTER_B=0x57d1dfC95e7bE9A1c578C6aAC95E9EA4Fd9CA16c
REPORTER_C=0xd4D6098963C814BfF30410C2E817A84020845662

# Canonical Pons V2 / Robinhood Chain contracts
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
PONS_MEME_HOOK=0xE5e702641Ea86F4ae6cC3cDaeD2B886f976Be044
PONS_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# Token metadata (token is NOT launched yet)
TOKEN_NAME=KILL THE BOSS
TOKEN_SYMBOL=KBOSS
TOKEN_LOGO_URI=ipfs://bafybeichwf5fc2dgt7dnknkblmftty7citw5v3tjwnfxuv5rbpiaubwcny
TOKEN_DESCRIPTION=Buy to deal damage. Sell to heal the boss. Every trade moves the fight. The wallet that lands the final blow wins the chest. No quests. No points. Just kill the boss.
WEBSITE_URL=
X_URL=
TELEGRAM_URL=
PONS_TRADE_URL=

# Persistence / chain scanning
# Public Robinhood RPC is rate-limited. 10s is the safe read-only default.
# For production traffic, set RPC_HTTP_URL to a dedicated Robinhood Chain provider.
DB_FILE=./data/boss.sqlite
# Alchemy Free currently allows eth_getLogs over at most 10 blocks.
SCAN_CHUNK_BLOCKS=10
LAUNCH_DISCOVERY_LOOKBACK=12000
# Optional: after launch, pin the known TokenLaunched block here. 0 = auto-discover.
TOKEN_LAUNCH_BLOCK=0
REPORTER_CONFIRMATIONS=8

# Safety gates. Keep false until the chosen trading paths have fixture tests.
# V1.4 requires explicit trader-attribution tests for direct wallets and every router.
TRADER_ADAPTER_VERIFIED=false
V4_REPORTING_ENABLED=false
MAX_BATCH_SIZE=64
BATCH_DEADLINE_SECONDS=600

# ------------------------------------------------------------
# OPERATIONS — OFF by default.
# The website/backend works read-only without any secret keys.
# Enable only after the reporter signers + relayer are configured.
# ------------------------------------------------------------
OPERATIONS_ENABLED=false

# The relayer submits keeper txs + reporter batches. Fund it with a small
# amount of ETH on Robinhood Chain. Never commit this key.
RELAYER_PRIVATE_KEY=

# Production recommendation: separate reporter signer processes with
# independent RPC providers. Any 2 of 3 valid endpoints are enough.
REPORTER_SIGNER_URLS=http://127.0.0.1:4101,http://127.0.0.1:4102,http://127.0.0.1:4103
REPORTER_SIGNER_TIMEOUT_MS=10000
# Optional shared bearer token for the coordinator -> signer HTTP hop.
# Required if a signer is exposed beyond localhost.
REPORTER_SIGNER_AUTH_TOKEN=

# Signer service settings (use one .env per signer process/machine).
SIGNER_HOST=127.0.0.1
SIGNER_PORT=4101
SIGNER_RPC_URL=
REPORTER_PRIVATE_KEY=
SIGNER_MAX_DEADLINE_SECONDS=900

# Demo mode only. APP_MODE=demo never submits chain transactions.
DEMO_CONTROLS=true
